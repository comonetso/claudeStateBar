# Ignore built files
out/
node_modules/
*.vsix

# Dev-only docs (not for public repo)
DEV-README.md
INTERNAL-DEV-NOTES.md
CLAUDE.md
whats-next.md

# peer_req address book for this repo: it names servers and their paths, so it stays local
.peer_req.json

# docs/ is private: session logs, codex_rescue run records and design notes carry server
# names and local paths. They are versioned in a separate private repository whose git
# directory is .git-docs (work tree = docs/, see tools/docs-git.sh), so no .git appears
# inside docs/ and this repo can keep tracking the two public guides below.
#
# The guides must stay at these exact paths: every installed copy of the extension opens
# https://github.com/comonetso/claudeStateBar/blob/main/docs/codex-rescue-guide(.ko).md
# (src/extension.ts, "setupCodexRescue"), and moving them would break that link for good.
/docs/*
!/docs/codex-rescue-guide.md
!/docs/codex-rescue-guide.ko.md
/.git-docs/

# paseo-plugins/ is private too: the Paseo plugins name servers and local paths and are not
# published. Since 2026-11-03 they are versioned in the private repository
# comonetso/blueming-paseo-plugins — git directory .git-paseo, work tree paseo-plugins/
# (tools/paseo-git.sh). Before that they sat on the plugins-next branch. The PC's Paseo loads
# them straight from this folder, so it stays where it is.
/paseo-plugins/
/.git-paseo/

# IDE
.vscode/
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db
.claude/
.file_history/

# Byte-compiled icon build script
__pycache__/

# 개인 API 키(Google 등) — 공개 저장소에 올리지 않는다(10-06)
.env
