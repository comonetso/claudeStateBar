# Ignore built files
out/
node_modules/
*.vsix

# Dev-only docs (not for public repo)
DEV-README.md
INTERNAL-DEV-NOTES.md
CLAUDE.md
whats-next.md

# docs/ is private: session logs, codex_rescue run records and design notes carry server
# names and local paths. They are versioned in a separate private repository whose git
# directory is .git-docs (work tree = docs/, see tools/docs-git.sh), so no .git appears
# inside docs/ and this repo can keep tracking the two public guides below.
#
# The guides must stay at these exact paths: every installed copy of the extension opens
# https://github.com/comonetso/claudeStateBar/blob/main/docs/codex-rescue-guide(.ko).md
# (src/extension.ts, "setupCodexRescue"), and moving them would break that link for good.
/docs/*
!/docs/codex-rescue-guide.md
!/docs/codex-rescue-guide.ko.md
/.git-docs/

# IDE
.vscode/
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db
.claude/
.file_history/

# Byte-compiled icon build script
__pycache__/
