src/**
# The codex_rescue skill lives in the repo so users can read and install it, but it is
# deliberately NOT shipped inside the extension: it spawns `codex exec` with workspace
# write access, which is a very different thing from a status-bar viewer. Users install it
# themselves after reading docs/codex-rescue-guide.md.
skills/**
images/provider-icons-src/**
images/provider-icons/*.json
images/icon-src/**
**/*.ts
**/*.map
tsconfig.json
.eslintrc*
whats-next.md
CLAUDE.md
# Dev-only probe scripts compiled into out/ (underscore prefix = never shipped)
out/_*.js
tools/**
