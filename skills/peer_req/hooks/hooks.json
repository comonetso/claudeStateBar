{
  "description": "peer_req: announce the plugin, check Remote Control auto-connect, report unreported peer requests and name an untitled session when a session starts; stop Claude from editing another repository's peer address book",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-addressbook.cjs\""
          }
        ]
      }
    ]
  }
}
