{
  "schemaVersion": 2,
  "ego": {
    "bin": "<absolute path to ego-browser.exe on the PC — setup finds it; on a server use remoteHost instead>",
    "callTimeoutMs": 300000,
    "settleMs": 15000,
    "light": true
  },
  "artifacts": {
    "retentionDays": 7,
    "storeScreenshots": true
  },
  "sites": [
    {
      "match": "https://dev.example.invalid:5173",
      "login": "rotating-refresh",
      "authPathPrefixes": ["/api/auth"],
      "guardWrites": true,
      "writeAllow": ["/api/auth/refresh"]
    }
  ]
}
