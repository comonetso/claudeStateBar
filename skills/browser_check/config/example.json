{
  "schemaVersion": 1,
  "mode": "auto",
  "aside": {
    "enabled": true,
    "bin": "<absolute-aside-cli-path>",
    "remoteHost": "<private-aside-host-name>",
    "maxConcurrent": 1,
    "evaluateTimeoutMs": 25000,
    "callTimeoutMs": 50000
  },
  "cdp": {
    "enabled": true,
    "remote": {
      "transport": "unix",
      "socketPath": "<absolute-private-unix-socket-path>"
    },
    "local": {
      "endpoint": "http://127.0.0.1:<private-local-cdp-port>",
      "daemonEndpoint": "http://127.0.0.1:<private-local-daemon-port>"
    },
    "policyProfile": "safe-v1",
    "connectTimeoutMs": 1000,
    "commandTimeoutMs": 10000
  },
  "artifacts": {
    "dir": "<absolute-plugin-data-dir>/artifacts",
    "retentionDays": 7,
    "storeRawProtocol": false,
    "storeScreenshots": true
  },
  "sites": [
    {
      "match": "https://dev.example.invalid:*",
      "login": "rotating-refresh",
      "diag": "vite-v2.1",
      "darkReader": "must-be-off-warn",
      "deepL": "hide-and-report",
      "allowDataMutation": false,
      "authPathPrefixes": ["/api/entry/", "/api/auth/"]
    }
  ]
}
